{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "orval.config.ts",
    "../.redberry/frontend/orval.config.ts",
    "../vitest.config.ts",
    "../playwright.config.ts",
    "../scripts/frontend/**/*.d.mts",
    "../scripts/frontend/application.vite.ts"
  ]
}
